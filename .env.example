# =============================================================================
# 8-Maktab loyihasi — muhit o'zgaruvchilari namunasi
#
# Ushbu faylni .env.local nomi bilan nusxalang va haqiqiy qiymatlarni kiriting.
# Vercel Dashboard: Project Settings → Environment Variables
#
# MUHIM: .env.local ni hech qachon GitHub ga yubormang (u .gitignore da).
# =============================================================================

# 1. Firebase Cloud Messaging (Web Push)
VITE_FCM_VAPID_KEY=YOUR_FCM_VAPID_KEY

# 2. Eskiz.uz SMS xizmati (faqat serverda ishlatiladi)
ESKIZ_EMAIL=YOUR_ESKIZ_EMAIL
ESKIZ_PASSWORD=YOUR_ESKIZ_PASSWORD
ESKIZ_FROM=4546
# ESKIZ_TOKEN=YOUR_ESKIZ_TOKEN
# ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# ESKIZ_FALLBACK_FROM=4546

# 3. SMS xavfsizligi va limitlari (ixtiyoriy)
# SMS_MAX_RECIPIENTS=300
# SMS_CONCURRENCY=4
# SMS_REQUIRE_AUTH=true
# SITE_URL=https://8-maktab.vercel.app

# 4. Firebase Admin SDK (Firestore va admin autentifikatsiyasi uchun)
# FIREBASE_PROJECT_ID=schoolnews-cd298
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@schoolnews-cd298.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
